    "hero-title":  "Engineering Intelligence \u003cspan class=\"text-brand-bright drop-shadow-[0_2px_15px_rgba(35,134,45,0.4)]\"\u003eSince 2008\u003c/span\u003e",
    "hero-title_pos":  {
